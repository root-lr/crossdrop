# Generated by packaging/homebrew/update.sh for each release; edit the template.
cask "crossdrop-app" do
  version "@VERSION@"
  sha256 "@SHA_DMG@"

  url "https://github.com/root-lr/crossdrop/releases/download/v#{version}/crossdrop_#{version}_universal.dmg"
  name "crossdrop"
  desc "Share files, clipboard, mouse and keyboard across your computers"
  homepage "https://github.com/root-lr/crossdrop"

  depends_on macos: :monterey

  app "crossdrop.app"

  zap trash: [
    "~/Library/Application Support/app.crossdrop.desktop",
    "~/Library/Application Support/crossdrop",
    "~/Library/Caches/app.crossdrop.desktop",
    "~/Library/WebKit/app.crossdrop.desktop",
  ]

  caveats <<~EOS
    crossdrop is not notarized by Apple yet. If macOS says it cannot be opened:
      xattr -dr com.apple.quarantine /Applications/crossdrop.app
    Sharing the mouse and keyboard needs the Accessibility permission:
    System Settings > Privacy & Security > Accessibility.
  EOS
end

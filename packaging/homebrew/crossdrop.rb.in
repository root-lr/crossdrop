# Generated by packaging/homebrew/update.sh for each release; edit the template.
class Crossdrop < Formula
  desc "Share files, clipboard, mouse and keyboard across your computers"
  homepage "https://github.com/root-lr/crossdrop"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    url "https://github.com/root-lr/crossdrop/releases/download/v@VERSION@/crossdrop-cli-v@VERSION@-universal-apple-darwin.tar.gz"
    sha256 "@SHA_MAC@"
  end

  on_linux do
    on_intel do
      url "https://github.com/root-lr/crossdrop/releases/download/v@VERSION@/crossdrop-cli-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_LINUX@"
    end
  end

  def install
    bin.install "crossdrop", "crossdropd", "interdesk"
  end

  # `brew services start crossdrop` keeps the daemon running in the background.
  service do
    run [opt_bin/"crossdropd"]
    keep_alive true
    log_path var/"log/crossdrop.log"
    error_log_path var/"log/crossdrop.log"
  end

  def caveats
    <<~EOS
      Start the daemon now and at login:
        brew services start crossdrop
      Then pair another computer:
        crossdrop devices
        crossdrop pair <name>
      interdesk (shared mouse and keyboard) needs the Accessibility permission
      on macOS: System Settings > Privacy & Security > Accessibility.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/crossdrop --version")
    assert_match version.to_s, shell_output("#{bin}/interdesk --version")
  end
end
